# Copy to .env and edit. All values optional.
MODEL_ORDER=gemini,ollama        # set to "ollama" to skip Gemini CLI entirely
GEMINI_CMD=gemini
GEMINI_MODEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
EMBED_MODEL=nomic-embed-text
MODEL_TIMEOUT=120
MODEL_RETRIES=1
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# KB_DIR=./kb
MCP_TRANSPORT=stdio              # or "http" (then start: python mcp_rag.py)
MCP_HOST=127.0.0.1
MCP_PORT=8765
